name: logs consumer
description: This is a logs consumer which consumes logs from Kafka and writes them to a postgresql database.
owner: DevAppSys

# PostgreSQL configuration
database:
  host: "127.0.0.1"
  port: 1111
  user: "pg-user"
  password: "password"
  dbname: "raw-logs"
  ssl-mode: true
  auto-migration: true

# Kafka configuration

kafka:
  brokers:
    - "kafka:9092" 
  buffer-channel-size: 10485760
  retry-attempts: 3

  topics:
    logs: logs
    events: events
    contexts: contexts
    logs-batch: logs-batch
    events-batch: events-batch
    contexts-batch: contexts-batch
    logs-file: logs-file
    events-file: events-file
    contexts-file: contexts-file